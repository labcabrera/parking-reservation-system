# Frontend environment variables
# Copy to .env.local for local development (never commit .env.local)

# URL of the BFF used by public hiring/search/booking flow (empty = use Vite proxy in dev, nginx proxy in Docker)
VITE_BFF_URL=http://localhost:8085

# Direct microservice URLs used only by administration screens
VITE_PARKING_FACILITIES_SERVICE_URL=http://localhost:8081
VITE_PRICING_SERVICE_URL=http://localhost:8083
VITE_ECOMMERCE_SERVICE_URL=http://localhost:8082

# URL of the Payment Gateway SPA
VITE_PAYMENT_GATEWAY_URL=http://localhost:3001

# Keycloak OIDC
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/parking
VITE_OIDC_CLIENT_ID=parking-client
VITE_OIDC_SCOPE=openid profile email
