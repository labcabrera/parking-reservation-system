# Frontend environment variables
# Copy to .env.local for local development (never commit .env.local)

# URL of the Catalog Service (empty = use Vite proxy in dev, nginx proxy in Docker)
VITE_CATALOG_SERVICE_URL=

# URL of the Reservation Service used to start reservations (empty = use Vite proxy in dev)
VITE_RESERVATION_SERVICE_URL=

# URL of the Payment Gateway SPA
VITE_PAYMENT_GATEWAY_URL=http://localhost:3001

# Keycloak OIDC
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=parking
VITE_KEYCLOAK_CLIENT_ID=parking-client
