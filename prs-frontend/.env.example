# Frontend environment variables
# Copy to .env.local for local development (never commit .env.local)

# URL of the BFF used by public hiring/search/booking flow (empty = use Vite proxy in dev, nginx proxy in Docker)
VITE_BFF_URL=http://localhost:8085

# Direct microservice URLs used only by administration screens
VITE_PARKING_FACILITIES_SERVICE_URL=http://localhost:8081
VITE_PRICING_SERVICE_URL=http://localhost:8083
VITE_ECOMMERCE_SERVICE_URL=http://localhost:8082

# URL of the Payment Gateway SPA
VITE_PAYMENT_GATEWAY_URL=http://localhost:3001

# Keycloak OIDC
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=parking
VITE_KEYCLOAK_CLIENT_ID=parking-client-front
VITE_KEYCLOAK_SCOPE=openid profile email
# By default the app derives callback URLs from window.location.origin.
# Override these only when Keycloak also allows the exact same origin.
# VITE_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/auth/logout-callback
# VITE_OIDC_SILENT_REDIRECT_URI=http://localhost:3000/auth/silent-callback
