{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:8082",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Orders",
      "description": "Create and manage ecommerce orders"
    },
    {
      "name": "Payment Methods",
      "description": "Payment methods supported by the ecommerce gateway"
    },
    {
      "name": "Payment Gateway",
      "description": "Checkout payment gateway reference data"
    }
  ],
  "paths": {
    "/api/v1/payment-methods/{id}": {
      "get": {
        "tags": ["Payment Methods"],
        "summary": "Get a supported payment method by id",
        "operationId": "getById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentMethod"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Payment Methods"],
        "summary": "Update a supported payment method",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePaymentMethodRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentMethod"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payment-methods": {
      "get": {
        "tags": ["Payment Methods"],
        "summary": "List supported payment methods",
        "operationId": "list",
        "parameters": [
          {
            "name": "activeOnly",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "name": "pageable",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Pageable"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponsePaymentMethod"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Payment Methods"],
        "summary": "Register a supported payment method",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentMethodRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentMethod"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "Search orders with optional filters",
        "operationId": "findAll",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDING_PAYMENT",
                "PAYMENT_IN_PROGRESS",
                "PAID",
                "EXPIRED",
                "CANCELLED",
                "PAYMENT_FAILED"
              ]
            }
          },
          {
            "name": "holdId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pageable",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Pageable"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOrder"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Orders"],
        "summary": "Create an order from a hold",
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}/pay": {
      "post": {
        "tags": ["Orders"],
        "summary": "Initiate payment for an order",
        "description": "Idempotent: re-submitting with the same idempotencyKey returns the original result without charging the customer again.",
        "operationId": "pay",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiatePaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/payments/methods": {
      "get": {
        "tags": ["Payment Gateway"],
        "summary": "List payment methods available at checkout",
        "operationId": "getAvailablePaymentMethods",
        "parameters": [
          {
            "name": "pageable",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Pageable"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentMethodsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/orders/{id}": {
      "get": {
        "tags": ["Orders"],
        "summary": "Get order details",
        "operationId": "getById_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdatePaymentMethodRequest": {
        "type": "object",
        "description": "Request payload to update a supported payment method",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["CARD", "WALLET", "BANK_TRANSFER", "CASH"]
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "INACTIVE"]
          },
          "gatewayProvider": {
            "type": "string",
            "minLength": 1
          },
          "iconUrl": {
            "type": "string"
          },
          "displayOrder": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "required": ["displayName", "gatewayProvider", "status", "type"]
      },
      "PaymentMethod": {
        "type": "object",
        "description": "Payment method supported by the ecommerce gateway",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["CARD", "WALLET", "BANK_TRANSFER", "CASH"]
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "INACTIVE"]
          },
          "gatewayProvider": {
            "type": "string"
          },
          "iconUrl": {
            "type": "string"
          },
          "displayOrder": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreatePaymentMethodRequest": {
        "type": "object",
        "description": "Request payload to register a supported payment method",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9_]+"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["CARD", "WALLET", "BANK_TRANSFER", "CASH"]
          },
          "gatewayProvider": {
            "type": "string",
            "minLength": 1
          },
          "iconUrl": {
            "type": "string"
          },
          "displayOrder": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        },
        "required": ["code", "displayName", "gatewayProvider", "type"]
      },
      "CreateOrderRequest": {
        "type": "object",
        "description": "Request payload to create an ecommerce order from a parking hold",
        "properties": {
          "holdId": {
            "type": "string",
            "format": "uuid",
            "description": "Hold identifier confirmed by the reservation flow"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Order expiration timestamp"
          },
          "amount": {
            "type": "number",
            "description": "Order amount",
            "examples": [37.5],
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "examples": ["EUR"],
            "minLength": 1
          }
        },
        "required": ["amount", "currency", "expiresAt", "holdId"]
      },
      "Order": {
        "type": "object",
        "description": "Ecommerce order",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Order identifier"
          },
          "holdId": {
            "type": "string",
            "format": "uuid",
            "description": "Hold identifier"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Order expiration timestamp"
          },
          "amount": {
            "type": "number",
            "description": "Order amount"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code"
          },
          "status": {
            "type": "string",
            "description": "Current order status",
            "enum": [
              "PENDING_PAYMENT",
              "PAYMENT_IN_PROGRESS",
              "PAID",
              "EXPIRED",
              "CANCELLED",
              "PAYMENT_FAILED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "lastPaymentAttemptId": {
            "type": "string",
            "format": "uuid",
            "description": "Last payment attempt identifier"
          },
          "failureReason": {
            "type": "string",
            "description": "Failure reason when payment failed"
          }
        }
      },
      "InitiatePaymentRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          },
          "paymentMethodCode": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["idempotencyKey", "paymentMethodCode"]
      },
      "Pageable": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "sort": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PaymentMethodsResponse": {
        "type": "object",
        "description": "Payment methods available at checkout",
        "properties": {
          "methods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentMethod"
            }
          }
        }
      },
      "PageResponsePaymentMethod": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentMethod"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PageResponseOrder": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "pagination": {
            "$ref": "#/components/schemas/Pagination"
          }
        }
      }
    }
  }
}
